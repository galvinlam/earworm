{
  "name": "earworm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn one line of an idea into a structured song draft \u2014 lyrics, chords, melody and a band to play it. Runs entirely in the browser.",
  "author": "Galvin Lam",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build --logLevel warn && vite build --config .smoke/vite.config.js --logLevel warn && vite build --config .smoke/browser/vite.config.js --logLevel warn && node .smoke/run.mjs",
    "proxy": "node tools/cors-proxy.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^2.0.0"
  },
  "license": "MIT",
  "keywords": [
    "songwriting",
    "lyrics",
    "music",
    "ai",
    "llm",
    "chords",
    "melody",
    "midi",
    "tone.js",
    "react",
    "vite",
    "openai-compatible",
    "openrouter",
    "music-theory",
    "web-audio"
  ],
  "homepage": "https://galvinlam.github.io/earworm/",
  "repository": {
    "type": "git",
    "url": "https://github.com/galvinlam/earworm.git"
  },
  "bugs": {
    "url": "https://github.com/galvinlam/earworm/issues"
  },
  "engines": {
    "node": ">=20.19"
  }
}
