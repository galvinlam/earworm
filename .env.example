# Earworm — optional environment defaults
#
# The app is fully client-side: by default you paste your API key into the
# in-app Settings panel and it is stored in your browser's localStorage only.
#
# These variables just pre-fill the Settings panel on first load. They are
# baked into the static bundle at build time, so DO NOT put a real secret key
# here for a site you intend to deploy publicly.

# Default base URL for an OpenAI-compatible endpoint.
#
# The app defaults to OpenRouter because it is the one free route that works
# from a browser with no proxy. Other options:
#   https://api.openai.com/v1                                 (paid)
#   https://api.groq.com/openai/v1                            (free tier)
#   https://generativelanguage.googleapis.com/v1beta/openai   (free tier)
#   http://localhost:11434/v1                                 (Ollama, local)
#   http://localhost:1234/v1                                  (LM Studio, local)
#   http://localhost:8787/v1    (npm run proxy — for NVIDIA NIM and anything
#                                else that refuses browser requests)
VITE_DEFAULT_BASE_URL=https://openrouter.ai/api/v1

# Default model id shown in the model selector.
# OpenRouter marks free variants with a ":free" suffix.
VITE_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local development convenience ONLY. Leave empty for any deployed build.
VITE_OPENAI_API_KEY=

# Set when deploying to a GitHub Pages *project* site, e.g. /earworm/
VITE_BASE=/

# Where guitar, bass and electric piano samples come from. Defaults to the
# Musyng Kite soundfont on gleitz.github.io (CC BY-SA 3.0). To self-host, copy
# the "<instrument>-mp3/" folders you use into public/samples/ and set this to
# /samples/ (or any URL ending in a slash).
VITE_SAMPLE_BASE_URL=
